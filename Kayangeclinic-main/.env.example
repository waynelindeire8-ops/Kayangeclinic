# Copy to .env for local runs (never commit .env).
# On Vercel / Fly.io set these as environment variables / secrets instead.

# Neon pooled connection string (host contains "-pooler"). sslmode=require is added automatically.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Long random values, different from each other (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Optional: OneDrive backup
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=
# ONEDRIVE_TENANT_ID=common
# ONEDRIVE_REFRESH_TOKEN=
# ONEDRIVE_USER_EMAIL=
